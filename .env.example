# AuctionFloor — environment variables
# Copy to .env for local dev. On Render, set these in the dashboard
# (Environment tab). NEVER commit a real key.

# Required: Postgres connection string. On Render this is injected
# automatically from the Render Postgres service (DATABASE_URL).
DATABASE_URL=postgres://auctionfloor:auctionfloor@localhost:5432/auctionfloor

# Port the server listens on. Render sets PORT automatically.
PORT=3000

# Public URL of the site. Used for Stripe success/cancel return URLs.
# Default: https://auction423.com
APP_URL=https://auction423.com

# Required for card payments: a Stripe SECRET key (restricted key) on the
# live Cash 4 Cars C&B account acct_1UYs2oRrelUqumEN, with
# Checkout Sessions: Write. Create it in the Stripe dashboard
# (Developers > API keys > Create restricted key). Never put a real key
# in code, in git, or in chat.
STRIPE_SECRET_KEY=

# Optional: Stripe webhook signing secret (Developers > Webhooks).
# If set, /api/stripe/webhook verifies Stripe's signature. If unset,
# the webhook endpoint rejects requests; payment verification still
# works through the "check payment status" button, which re-reads the
# Checkout Session directly from Stripe.
STRIPE_WEBHOOK_SECRET=

# Required for owner login sessions (any long random string).
SESSION_SECRET=change-me-to-a-long-random-string

# Where listing photos are stored on disk. Default: ./uploads
# NOTE: on Render this is ephemeral disk. S3-compatible object storage
# is the follow-up for durable photo hosting (see README).
UPLOADS_DIR=./uploads

# Optional: email notifications (win / fee / paid / pickup / delivery).
# If SENDGRID_API_KEY and EMAIL_FROM are both set, emails are sent via
# SendGrid. If absent, email copies are queued in-app (sent_at stays
# empty) and the sale is never blocked by a missing provider.
SENDGRID_API_KEY=
EMAIL_FROM=

# Optional: SMS notifications. If all three are set, texts are sent via
# Twilio. If absent, SMS copies are queued in-app (sent_at stays empty)
# and the sale is never blocked by a missing provider.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
